digraph TestPipe_PPT_Sequence {
    rankdir=LR;
    graph [pad="0.35", ranksep="1.0", nodesep="0.35", bgcolor="white"];
    node [shape=box, style="rounded,filled", fontname="Microsoft YaHei", fontsize=11, color="#555555"];
    edge [fontname="Microsoft YaHei", fontsize=9, color="#6B7280", arrowsize=0.75];

    CLI [label="CLI / 调用方", fillcolor="#FCE7F3", color="#DB2777", penwidth=1.8];
    Loader [label="TestCase Loader", fillcolor="#E0F2FE", color="#0284C7", penwidth=1.6];
    Registry [label="PipelineRegistry", fillcolor="#DBEAFE", color="#2563EB", penwidth=1.6];
    Engine [label="TestEngine", fillcolor="#BFDBFE", color="#1D4ED8", penwidth=2.0];
    Pipeline [label="Pipeline", fillcolor="#FEF3C7", color="#D97706", penwidth=1.8];
    TestOp [label="TestOp", fillcolor="#DCFCE7", color="#16A34A", penwidth=1.8];
    OpAPI [label="OpAPI", fillcolor="#CCFBF1", color="#0F766E", penwidth=1.8];
    Backend [label="底层能力\nSSH / Exec / Transfer / File", fillcolor="#F0FDFA", color="#0F766E", penwidth=1.4];
    Result [label="结果汇总", fillcolor="#F3F4F6", color="#6B7280", penwidth=1.6];

    CLI -> Loader [label="1. 读取 YAML 测试用例", penwidth=1.8, color="#DB2777"];
    Loader -> Registry [label="2. 按 pipeline 名称查找定义", penwidth=1.6];
    Registry -> Engine [label="3. 返回 Pipeline 实例", penwidth=1.6];
    CLI -> Engine [label="4. 提交输入参数并启动执行", penwidth=2.0, color="#1D4ED8"];
    Engine -> Engine [label="5. 校验 DAG / 构建上下文 / 注入 API", penwidth=1.8, color="#1D4ED8"];
    Engine -> Pipeline [label="6. 调用 run / forward", penwidth=2.0, color="#1D4ED8"];
    Pipeline -> TestOp [label="7. 按拓扑顺序逐个执行算子", penwidth=2.0, color="#D97706"];
    TestOp -> OpAPI [label="8. 通过统一接口发起操作", penwidth=2.0, color="#16A34A"];
    OpAPI -> Backend [label="9. 执行底层命令或传输", penwidth=1.8, color="#0F766E"];
    Backend -> OpAPI [label="10. 返回执行结果", style=dashed, color="#0F766E"];
    OpAPI -> TestOp [label="11. 返回标准化响应", style=dashed, color="#16A34A"];
    TestOp -> Pipeline [label="12. 输出中间产物", style=dashed, color="#16A34A"];
    Pipeline -> Engine [label="13. 汇总 Pipeline 输出", style=dashed, color="#D97706"];
    Engine -> Result [label="14. 生成状态 / 日志 / 结果目录", penwidth=1.8, color="#4B5563"];
    Result -> CLI [label="15. 返回最终结论", style=dashed, color="#6B7280"];
}
